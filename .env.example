DATABASE_URL=postgresql://met:met@localhost:5432/met
# Comma-separated department IDs. 6 Asian Art, 9 Drawings and Prints, 10 Egyptian Art, 11 European Paintings.
# Start with one department until the pipeline works end to end, then widen.
DEPARTMENTS=6
MAX_OBJECTS_PER_DEPT=5000
MET_RPS=15
IMAGE_RPS=5
IMAGE_DIR=data/images
EMBEDDER=clip
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
# Only needed for the natural-language filter parser and "why similar?"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
